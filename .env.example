# Backend URL used by Next.js rewrites and server-side API requests.
BACKEND_URL=http://localhost:5000

# Public canonical site origin used for metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Cloudinary account setting.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional public settings. Leave unset to hide the corresponding UI.
NEXT_PUBLIC_SHOP_URL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format; the site converts it to the digits-only wa.me format.
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Optional social profile URLs. Leave unset to hide each footer icon.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
